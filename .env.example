# Ứng dụng
APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=debug

# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT phải LỚN HƠN HTTP_HANDLER_TIMEOUT, nếu không response lỗi
# lúc hết giờ không kịp ghi ra và client chỉ thấy kết nối bị đóng.
HTTP_HANDLER_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=35s
HTTP_SHUTDOWN_TIMEOUT=30s

# PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/base_ecommerce?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Redis
REDIS_ADDR=localhost:6380
REDIS_POOL_SIZE=20

# RabbitMQ
# URI CHỨA MẬT KHẨU. Config.String() che nó lại trước khi ghi log — đừng in
# thẳng biến này ra ở bất kỳ đâu.
RABBITMQ_URL=amqp://app:app@localhost:5672/

# Object storage (P1.4) — MinIO khi dev, S3/R2 khi production.
# S3_PUBLIC_ENDPOINT: địa chỉ NGƯỜI UPLOAD thấy; URL upload được ký bằng nó.
# S3_SECRET_KEY: production bị CHẶN khởi động nếu còn là mật khẩu dev.
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=app
S3_SECRET_KEY=app-secret-dev
S3_BUCKET=catalog
S3_REGION=us-east-1
S3_USE_SSL=false

# Xác thực (P2.1). JWT_SECRET ≥ 32 byte; production bị CHẶN khởi động nếu còn
# giá trị dev mặc định. Sinh: openssl rand -base64 48
JWT_SECRET=dev-jwt-secret-chi-dung-tren-may-local-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Storefront Next.js (apps/web)
# API_URL: gốc của backend Go mà Next.js gọi TỪ PHÍA SERVER. Trong container
# phải là tên service (http://api:8080/api/v1), không phải localhost — localhost
# bên trong container trỏ về chính tiến trình Next.js.
API_URL=http://localhost:8080/api/v1
# SITE_URL: địa chỉ công khai của storefront, gốc của <link rel="canonical">,
# sitemap.xml và trường offers.url trong JSON-LD.
#
# ⚠️ TRÊN PRODUCTION PHẢI ĐỔI THÀNH TÊN MIỀN THẬT. Để nguyên mặc định thì mọi
# thẻ canonical và mọi URL trong sitemap đều trỏ về http://localhost:3000 —
# Google đọc đúng thứ ta khai, kết luận trang thật là bản sao của một địa chỉ
# nó không vào được, và gỡ dần cửa hàng khỏi kết quả tìm kiếm. Không có lỗi nào
# hiện ra, chỉ là vài tuần sau traffic tự nhiên biến mất.
#
# Không đặt tiền tố NEXT_PUBLIC_: biến đó bị nhúng cứng vào bundle lúc
# `next build`, nên một image build ở staging sẽ mang URL staging lên tận
# production. Xem apps/web/lib/site.ts.
SITE_URL=http://localhost:3000
# IMGPROXY_URL: imgproxy mà Route Handler /img/* của Next.js chuyển tiếp tới.
# Đọc lúc chạy (không phải NEXT_PUBLIC_*). Trong container: http://imgproxy:8080.
IMGPROXY_URL=http://localhost:8081
